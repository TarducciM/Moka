{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moka",
  "version": "0.5.0",
  "identifier": "com.moka.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "Moka",
        "width": 340,
        "height": 440,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Moka",
        "width": 520,
        "height": 660,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "Moka",
        "width": 360,
        "height": 150,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": false,
        "focusable": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Michele Tarducci",
    "copyright": "© 2026 Michele Tarducci. MIT License.",
    "category": "Utility",
    "shortDescription": "Tieni sveglio il PC dalla tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "homepage": "https://moka.mtsolutions.studio",
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "fragmentPaths": [
          "wix/uninstall-guard.wxs"
        ],
        "componentRefs": [
          "MokaUninstallGuard"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MkU2QzQzRjE0RTJGMTMKUldRVEwwN3hRMnd1ZENIRXZwZnUweEV2eUxleVpIOG9RdFNrNkt6T3lUbEJXYTkzd2dDYmZXTkMK",
      "endpoints": [
        "https://github.com/TarducciM/Moka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
